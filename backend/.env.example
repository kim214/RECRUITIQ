PORT=3001
JWT_SECRET=change-this-to-a-long-random-secret
# Comma-separated extra browser origins (production already uses PUBLIC_APP_URL)
# CORS_ORIGINS=https://custom-domain.example
# AUTH_RATE_LIMIT=20
# AI_RATE_LIMIT=40

# ─── Supabase (get from: Project Settings → API) ───
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGci...paste-service-role-key-here

# ─── AI — GCP VM (Ollama + optional Tesseract sidecar) ───
# Production and local should both point at the VM, not a laptop Ollama.
#   OLLAMA_BASE_URL=http://YOUR_VM_EXTERNAL_IP
# Local-only fallback: http://127.0.0.1:11434
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# Leave unset so only one chat model runs. Embeddings use nomic-embed-text separately.
# OLLAMA_FALLBACK_MODEL=
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_API_KEY=required when using GCP VM behind Nginx
# OLLAMA_TIMEOUT_MS=300000
# OLLAMA_HEALTH_TIMEOUT_MS=8000
# OCR uses the same host as OLLAMA_BASE_URL (POST /ocr) unless overridden:
# OCR_BASE_URL=http://YOUR_VM_EXTERNAL_IP
# OCR_API_KEY=same as OLLAMA_API_KEY
# OCR_TIMEOUT_MS=60000
# OCR_ENABLED=0
# DOC_LLM_MAX_CHARS=12000
# DOC_MAX_BYTES=10485760
# Demo / CPU VM: skip extra narrative LLM. Scores still come from requirement matching.
ANALYSIS_FAST=1
# ANALYSIS_FAST=0

# ─── Email (role-change, welcome, ban notices) ───
# Prefer Resend. SMTP is used if RESEND_API_KEY is not set.
PUBLIC_APP_URL=https://recruitiq-self.vercel.app
MAIL_FROM=RecruitIQ <noreply@recruitiq.app>
# RESEND_API_KEY=re_xxxxxxxx
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
