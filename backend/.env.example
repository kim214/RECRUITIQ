PORT=3001
JWT_SECRET=change-this-to-a-long-random-secret

# ─── Supabase (get from: Project Settings → API) ───
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGci...paste-service-role-key-here

# ─── AI — Ollama ───
# Local dev can use GCP VM (recommended — same as Vercel):
#   OLLAMA_BASE_URL=http://YOUR_VM_EXTERNAL_IP
# Or local Ollama: http://127.0.0.1:11434
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma2:2b
OLLAMA_FALLBACK_MODEL=qwen2.5:0.5b
# OLLAMA_API_KEY=required when using GCP VM behind Nginx
# OLLAMA_TIMEOUT_MS=240000
