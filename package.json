{
  "name": "reqruit-iq",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node backend/server.js",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev --prefix backend\" \"npm run dev --prefix client\"",
    "dev:api": "npm run dev --prefix backend",
    "dev:web": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "seed:supabase": "cd backend && npm run seed:supabase",
    "create:admin": "cd backend && npm run create:admin"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "uuid": "^10.0.0"
  }
}
